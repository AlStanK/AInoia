# Копія: cp deploy/.env.example deploy/.env — і заповнити.
# deploy/.env у git не потрапляє (.gitignore). Значення — у ~/.claude/secrets-registry.md.

# Підключення PostgREST до наявного кластера Postgres.
# Роль authenticator має право лише SET ROLE web_anon / diagnostic_reader.
PGRST_DB_URI=postgres://authenticator:ПАРОЛЬ@codis-pg-rw.codis-infra.svc.cluster.local:5432/poll
PGRST_DB_SCHEMA=diagnostic
PGRST_DB_ANON_ROLE=web_anon
PGRST_SERVER_PORT=3000

# Домени, з яких сторінка звертається до API
PGRST_SERVER_CORS_ALLOWED_ORIGINS=https://diagnostic.ainoia.example
